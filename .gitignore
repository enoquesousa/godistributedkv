# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# Protobuf generated files (Optional: common to commit them, but good to know)
# api/proto/*.pb.go

# Local runtime data, build outputs and private development certificates
/bin/
/data/
/main
/certs/
*.key
*.pem
